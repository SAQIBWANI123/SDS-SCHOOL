<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Grade List View -->
    <record id="view_school_grade_tree" model="ir.ui.view">
        <field name="name">school.grade.list</field>
        <field name="model">school.grade</field>
        <field name="arch" type="xml">
            <list string="Grades / Standards">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
            </list>
        </field>
    </record>

    <!-- Grade Form View -->
    <record id="view_school_grade_form" model="ir.ui.view">
        <field name="name">school.grade.form</field>
        <field name="model">school.grade</field>
        <field name="arch" type="xml">
            <form string="Grade Level">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Grade 10"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="sequence"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Curriculum Subjects">
                            <field name="subject_ids">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="subject_type"/>
                                    <field name="pass_mark"/>
                                    <field name="max_mark"/>
                                </list>
                            </field>
                        </page>
                        <page string="Classes / Sections">
                            <field name="class_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="section"/>
                                    <field name="class_teacher_id"/>
                                    <field name="student_count"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_school_grade" model="ir.actions.act_window">
        <field name="name">Grade Levels</field>
        <field name="res_model">school.grade</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menuitem -->
    <menuitem id="menu_school_grade"
              name="Grade Levels"
              parent="menu_school_config_root"
              action="action_school_grade"
              sequence="2"/>
</odoo>
