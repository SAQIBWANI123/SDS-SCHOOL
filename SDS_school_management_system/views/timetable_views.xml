<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_timetable_tree" model="ir.ui.view">
        <field name="name">school.timetable.list</field>
        <field name="model">school.timetable</field>
        <field name="arch" type="xml">
            <list string="Class Timetables">
                <field name="name"/>
                <field name="class_id"/>
                <field name="academic_year_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_school_timetable_form" model="ir.ui.view">
        <field name="name">school.timetable.form</field>
        <field name="model">school.timetable</field>
        <field name="arch" type="xml">
            <form string="Class Timetable">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="class_id"/>
                        </group>
                        <group>
                            <field name="academic_year_id"/>
                            <field name="term_id"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Weekly Schedule Slots">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="day_of_week"/>
                                    <field name="period_number"/>
                                    <field name="subject_id"/>
                                    <field name="teacher_id"/>
                                    <field name="room_number"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_school_timetable" model="ir.actions.act_window">
        <field name="name">Class Timetables</field>
        <field name="res_model">school.timetable</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_school_timetable"
              name="Class Timetables"
              parent="menu_school_academics_root"
              action="action_school_timetable"
              sequence="3"/>
</odoo>
