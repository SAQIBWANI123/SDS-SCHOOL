<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- ── 1. PORTAL HOME LINKS ─────────────────────────────────────────────── -->
<template id="portal_my_home_school_links"
          inherit_id="portal.portal_my_home"
          name="School Portal Links">
  <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">

    <!-- Portal home quick links (shown to all logged-in users) -->
    <div class="sds_portal_wrap mt-3 w-100">
      <a class="list-group-item list-group-item-action d-flex align-items-center gap-2 py-3"
         href="/school/admission">
        <span class="fa fa-pencil fa-fw text-warning"/>
        <div>
          <strong>Apply for Admission</strong>
          <small class="d-block text-muted">Submit a new online application — open to everyone</small>
        </div>
      </a>
      <t t-if="request.env.user.id and request.env.user.id != request.env.ref('base.public_user').id">
        <a class="list-group-item list-group-item-action d-flex align-items-center gap-2 py-3"
           href="/my/school/fees">
          <span class="fa fa-money fa-fw text-success"/>
          <div>
            <strong>My School Fees</strong>
            <small class="d-block text-muted">View fee statements and balances for your children</small>
          </div>
        </a>
        <a class="list-group-item list-group-item-action d-flex align-items-center gap-2 py-3"
           href="/my/school/students">
          <span class="fa fa-child fa-fw text-primary"/>
          <div>
            <strong>My Children</strong>
            <small class="d-block text-muted">Attendance, report cards and transport for your children</small>
          </div>
        </a>
      </t>
    </div>
  </xpath>
</template>

<!-- ═══════════════════════════════════════════════════════════════════════════
     2. ONLINE ADMISSION FORM  (auth=public — no login needed)
     ═══════════════════════════════════════════════════════════════════════════ -->
<template id="portal_admission_form" name="Online Admission Application">
  <t t-call="website.layout">
    <div id="wrap" class="oe_structure sds_portal_wrap">
      <div class="container py-5">
        <div class="sds_hero mb-4">
          <span class="sds_hero_badge"><i class="fa fa-pencil-square-o me-1"/> Admissions</span>
          <h1>Online Admission Application</h1>
          <p>Complete the form below. Our admissions team will review your application within 2–3 business days.</p>
        </div>
        <div class="row justify-content-center">
          <div class="col-lg-9">
            <div class="sds_card">
              <form action="/school/admission/submit" method="post" enctype="multipart/form-data">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <div class="sds_form_section">
                  <h3 class="sds_section_title"><i class="fa fa-user-circle-o"/>Student Information</h3>
                  <div class="row g-3">
                    <div class="col-md-6">
                      <label class="sds_form_label">Student Name <span class="req">*</span></label>
                      <input class="sds_input" name="student_name" placeholder="Full legal name" required="required"/>
                    </div>
                    <div class="col-md-6">
                      <label class="sds_form_label">Date of Birth <span class="req">*</span></label>
                      <input class="sds_input" type="date" name="date_of_birth" required="required"/>
                    </div>
                    <div class="col-md-6">
                      <label class="sds_form_label">Gender <span class="req">*</span></label>
                      <select class="sds_select" name="gender" required="required">
                        <option value="">— Select gender —</option>
                        <option value="male">Male</option>
                        <option value="female">Female</option>
                        <option value="other">Other</option>
                      </select>
                    </div>
                    <div class="col-md-6">
                      <label class="sds_form_label">Applying for Grade <span class="req">*</span></label>
                      <select class="sds_select" name="grade_id" required="required">
                        <option value="">— Select grade —</option>
                        <t t-foreach="grades" t-as="grade">
                          <option t-att-value="grade.id" t-out="grade.name"/>
                        </t>
                      </select>
                    </div>
                    <div class="col-12">
                      <label class="sds_form_label">Academic Year</label>
                      <select class="sds_select" name="academic_year_id">
                        <option value="">— Select year (optional) —</option>
                        <t t-foreach="years" t-as="year">
                          <option t-att-value="year.id" t-out="year.name"/>
                        </t>
                      </select>
                    </div>
                  </div>
                </div>
                <div class="sds_form_section">
                  <h3 class="sds_section_title"><i class="fa fa-users"/>Parent / Guardian Details</h3>
                  <div class="row g-3">
                    <div class="col-md-6">
                      <label class="sds_form_label">Guardian Name <span class="req">*</span></label>
                      <input class="sds_input" name="guardian_name" placeholder="Full name" required="required"/>
                    </div>
                    <div class="col-md-6">
                      <label class="sds_form_label">Relationship</label>
                      <input class="sds_input" name="guardian_relation" placeholder="Mother / Father / Guardian"/>
                    </div>
                    <div class="col-md-6">
                      <label class="sds_form_label">Email Address <span class="req">*</span></label>
                      <input class="sds_input" type="email" name="guardian_email" placeholder="you@example.com" required="required"/>
                    </div>
                    <div class="col-md-6">
                      <label class="sds_form_label">Phone Number <span class="req">*</span></label>
                      <input class="sds_input" name="guardian_phone" placeholder="+1 (555) 000-0000" required="required"/>
                    </div>
                    <div class="col-12">
                      <label class="sds_form_label">Residential Address</label>
                      <textarea class="sds_textarea" name="address" rows="2" placeholder="Street, City, Country"/>
                    </div>
                  </div>
                </div>
                <div class="sds_form_section">
                  <h3 class="sds_section_title"><i class="fa fa-paperclip"/>Documents &amp; Notes</h3>
                  <div class="row g-3">
                    <div class="col-12">
                      <label class="sds_form_label">Supporting Documents</label>
                      <input class="sds_input" type="file" name="documents" multiple="multiple" style="padding:7px 10px;"/>
                      <span class="sds_hint"><i class="fa fa-info-circle me-1"/>Accepted: PDF, JPG, PNG. You may select multiple files.</span>
                    </div>
                    <div class="col-12">
                      <label class="sds_form_label">Additional Notes</label>
                      <textarea class="sds_textarea" name="notes" rows="3" placeholder="Any special requirements, previous school details, etc."/>
                    </div>
                  </div>
                </div>
                <div class="d-flex gap-3 align-items-center">
                  <button type="submit" class="sds_btn sds_btn_primary">
                    <i class="fa fa-paper-plane"/> Submit Application
                  </button>
                  <span style="font-size:12px;color:var(--sds-muted);">
                    <i class="fa fa-lock me-1"/>Your information is kept secure.
                  </span>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </t>
</template>

<template id="portal_admission_form_errors"
          inherit_id="SDS_school_management_system.portal_admission_form"
          name="Admission Form Errors">
  <xpath expr="//form[@action='/school/admission/submit']" position="before">
    <div t-if="error" class="sds_alert_error" role="alert">
      <i class="fa fa-exclamation-triangle me-2"/><t t-out="error"/>
    </div>
  </xpath>
</template>

<!-- ═══════════════════════════════════════════════════════════════════════════
     3. ADMISSION SUCCESS
     ═══════════════════════════════════════════════════════════════════════════ -->
<template id="portal_admission_success" name="Admission Submitted">
  <t t-call="website.layout">
    <div id="wrap" class="oe_structure sds_portal_wrap">
      <div class="container py-5">
        <div class="row justify-content-center">
          <div class="col-lg-7 text-center">
            <div class="sds_alert_success">
              <div style="width:64px;height:64px;border-radius:50%;background:var(--sds-teal);color:#fff;
                          display:flex;align-items:center;justify-content:center;font-size:28px;margin:0 auto 18px;">
                <i class="fa fa-check"/>
              </div>
              <h2>Application Submitted!</h2>
              <p>
                Thank you! Your reference number is
                <strong style="color:var(--sds-teal-dk);" t-out="admission.name"/>.
                Our admissions team will contact you shortly after review.
              </p>
              <div class="d-flex gap-3 justify-content-center flex-wrap">
                <a href="/school/admission" class="sds_btn sds_btn_outline">
                  <i class="fa fa-plus"/> Submit Another
                </a>
                <a href="/my/school/fees" class="sds_btn sds_btn_primary">
                  <i class="fa fa-money"/> Parent Fee Portal
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </t>
</template>

<!-- ═══════════════════════════════════════════════════════════════════════════
     4. FEE LIST  (auth=user — parents see only their own children's fees)
     ═══════════════════════════════════════════════════════════════════════════ -->
<template id="portal_fee_list" name="My School Fees">
  <t t-call="portal.portal_layout">
    <div class="sds_portal_wrap container py-4">

      <!-- Hero -->
      <div class="sds_hero">
        <span class="sds_hero_badge"><i class="fa fa-money me-1"/> Finance</span>
        <h1>My School Fees</h1>
        <p>Fee statements and balances for your linked children.</p>
        <a href="/my/school/students"
           class="sds_btn mt-3"
           style="background:rgba(255,255,255,.18);border:1.5px solid rgba(255,255,255,.35);color:#fff;">
          <i class="fa fa-child"/> My Children
        </a>
      </div>

      <!-- Student filter tabs (shown when parent has > 1 child) -->
      <t t-if="students and len(students) > 1">
        <div class="sds_filter_bar">
          <span class="sds_filter_label"><i class="fa fa-filter me-1"/>Filter by child:</span>
          <a href="/my/school/fees"
             t-attf-class="sds_filter_btn #{'active' if not selected_student else ''}">
            All Children
          </a>
          <t t-foreach="students" t-as="s">
            <a t-att-href="'/my/school/fees?student_id=%s' % s.id"
               t-attf-class="sds_filter_btn #{'active' if selected_student and selected_student.id == s.id else ''}">
              <t t-out="s.name"/>
            </a>
          </t>
        </div>
      </t>

      <!-- Summary stats -->
      <div class="sds_stat_row">
        <div class="sds_stat">
          <div class="sds_stat_label"><i class="fa fa-file-text-o"/>Total Billed</div>
          <div class="sds_stat_value ink" t-out="'%.2f' % total_amount"/>
        </div>
        <div class="sds_stat">
          <div class="sds_stat_label"><i class="fa fa-check-circle"/>Collected</div>
          <div class="sds_stat_value green" t-out="'%.2f' % total_paid"/>
        </div>
        <div class="sds_stat">
          <div class="sds_stat_label"><i class="fa fa-exclamation-circle"/>Balance Due</div>
          <div class="sds_stat_value red" t-out="'%.2f' % total_due"/>
        </div>
      </div>

      <!-- Fee table -->
      <div class="sds_card">
        <div class="sds_card_head">
          <div>
            <span class="sds_eyebrow"><i class="fa fa-list"/> Statements</span>
            <h2 t-if="selected_student">
              Fees for <t t-out="selected_student.name"/>
            </h2>
            <h2 t-else="">All Fee Invoices</h2>
          </div>
        </div>
        <div class="table-responsive">
          <table class="sds_tbl">
            <thead>
              <tr>
                <th>Invoice</th>
                <th>Student</th>
                <th>Due Date</th>
                <th class="text-end">Total</th>
                <th class="text-end">Paid</th>
                <th class="text-end">Balance</th>
                <th>Status</th>
                <th/>
              </tr>
            </thead>
            <tbody>
              <tr t-foreach="fees" t-as="fee">
                <td>
                  <span style="font-weight:700;color:var(--sds-indigo);">
                    <i class="fa fa-file-text-o me-1" style="opacity:.5;"/>
                    <t t-out="fee.name"/>
                  </span>
                </td>
                <td>
                  <a t-att-href="'/my/school/students/%s' % fee.student_id.id"
                     style="font-weight:600;color:var(--sds-ink);text-decoration:none;">
                    <t t-out="fee.student_id.name"/>
                  </a>
                </td>
                <td style="color:var(--sds-muted);font-size:12px;"><t t-out="fee.date_due"/></td>
                <td class="text-end" style="font-weight:600;"><t t-out="'%.2f' % fee.amount_total"/></td>
                <td class="text-end" style="color:var(--sds-teal-dk);font-weight:600;"><t t-out="'%.2f' % fee.amount_paid"/></td>
                <td class="text-end" style="color:var(--sds-rose-dk);font-weight:700;"><t t-out="'%.2f' % fee.amount_due"/></td>
                <td>
                  <span t-attf-class="sds_badge sds_badge_#{fee.state}">
                    <t t-out="fee_state_labels.get(fee.state, fee.state)"/>
                  </span>
                </td>
                <td>
                  <a t-att-href="'/my/school/fees/%s' % fee.id" class="sds_btn sds_btn_outline sds_btn_sm">
                    View <i class="fa fa-chevron-right ms-1"/>
                  </a>
                </td>
              </tr>
              <tr t-if="not fees">
                <td colspan="8">
                  <div class="sds_empty">
                    <i class="fa fa-file-o"/>
                    No fee statements are available at this time.
                  </div>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </t>
</template>

<!-- ═══════════════════════════════════════════════════════════════════════════
     5. STUDENT LIST  (My Children – auth=user)
     ═══════════════════════════════════════════════════════════════════════════ -->
<template id="portal_student_list" name="My Children">
  <t t-call="portal.portal_layout">
    <div class="sds_portal_wrap container py-4">
      <div class="sds_hero">
        <span class="sds_hero_badge"><i class="fa fa-child me-1"/> Students</span>
        <h1>My Children</h1>
        <p>View attendance, report cards, transport and fees for each child.</p>
      </div>

      <div class="sds_student_grid">
        <t t-foreach="students" t-as="student">
          <div class="sds_student_card">
            <div class="d-flex align-items-center gap-3">
              <div class="sds_student_avatar">
                <t t-out="(student.name or 'S')[0].upper()"/>
              </div>
              <div>
                <h3 class="sds_student_name"><t t-out="student.name"/></h3>
                <span class="sds_student_meta">
                  <i class="fa fa-graduation-cap me-1"/>
                  <t t-out="student.grade_id.name or 'No grade'"/>
                  <t t-if="student.class_id">
                    <span class="mx-1">·</span><t t-out="student.class_id.name"/>
                  </t>
                </span>
              </div>
            </div>
            <!-- Quick stats row -->
            <div class="d-flex gap-2 flex-wrap" style="font-size:11px;color:var(--sds-muted);">
              <span><i class="fa fa-circle me-1" style="color:var(--sds-teal);"/>
                <t t-out="(student.state or 'active').capitalize()"/>
              </span>
              <t t-if="student.date_of_birth">
                <span>· <i class="fa fa-birthday-cake me-1"/><t t-out="student.date_of_birth"/></span>
              </t>
            </div>
            <div class="d-flex gap-2 flex-wrap">
              <a t-att-href="'/my/school/students/%s' % student.id" class="sds_btn sds_btn_primary sds_btn_sm">
                <i class="fa fa-eye"/> View Profile
              </a>
              <a t-att-href="'/my/school/fees?student_id=%s' % student.id" class="sds_btn sds_btn_outline sds_btn_sm">
                <i class="fa fa-money"/> Fees
              </a>
            </div>
          </div>
        </t>

        <t t-if="not students">
          <div class="col-12">
            <div class="sds_card">
              <div class="sds_empty">
                <i class="fa fa-user-times"/>
                No children are linked to this parent account. Please contact the school.
              </div>
            </div>
          </div>
        </t>
      </div>
    </div>
  </t>
</template>

<!-- ═══════════════════════════════════════════════════════════════════════════
     6. STUDENT DETAIL PAGE  (attendance + report card + transport – auth=user)
     ═══════════════════════════════════════════════════════════════════════════ -->
<template id="portal_student_detail" name="Student Details">
  <t t-call="portal.portal_layout">
    <div class="sds_portal_wrap container py-4">

      <a href="/my/school/students" class="sds_back">
        <i class="fa fa-arrow-left"/> Back to My Children
      </a>

      <!-- Profile header -->
      <div class="sds_card mb-4">
        <div class="d-flex align-items-center gap-4 flex-wrap">
          <div class="sds_student_avatar" style="width:72px;height:72px;font-size:30px;flex-shrink:0;">
            <t t-out="(student.name or 'S')[0].upper()"/>
          </div>
          <div class="flex-grow-1">
            <h1 style="font-size:24px;font-weight:800;margin:0 0 5px;"><t t-out="student.name"/></h1>
            <span class="sds_student_meta">
              <i class="fa fa-graduation-cap me-1"/>
              <t t-out="student.grade_id.name or 'No grade assigned'"/>
              <t t-if="student.class_id">
                <span class="mx-2">·</span>
                <i class="fa fa-users me-1"/><t t-out="student.class_id.name"/>
              </t>
            </span>
          </div>
          <a t-att-href="'/my/school/fees?student_id=%s' % student.id" class="sds_btn sds_btn_primary">
            <i class="fa fa-money"/> View Fees
          </a>
        </div>
      </div>

      <!-- Info tiles -->
      <div class="sds_info_grid mb-4">
        <div class="sds_info_item">
          <span class="label"><i class="fa fa-id-card-o me-1"/>Registration ID</span>
          <span class="value"><t t-out="student.student_id_code or '—'"/></span>
        </div>
        <div class="sds_info_item">
          <span class="label"><i class="fa fa-circle me-1"/>Status</span>
          <span class="value" style="text-transform:capitalize;"><t t-out="student.state or '—'"/></span>
        </div>
        <div class="sds_info_item">
          <span class="label"><i class="fa fa-birthday-cake me-1"/>Date of Birth</span>
          <span class="value"><t t-out="student.date_of_birth or '—'"/></span>
        </div>
      </div>

      <!-- ── TRANSPORT / VEHICLE ─────────────────────────────────────────── -->
      <div class="sds_card sds_transport_card mb-4">
        <div class="sds_card_head">
          <div>
            <span class="sds_eyebrow" style="color:var(--sds-teal-dk);"><i class="fa fa-bus"/> Transport</span>
            <h2>Vehicle / Transport Subscription</h2>
          </div>
        </div>
        <t t-if="transport">
          <div class="table-responsive">
            <table class="sds_tbl">
              <thead>
                <tr>
                  <th>Route</th>
                  <th>Vehicle</th>
                  <th>Driver</th>
                  <th>Pickup Point</th>
                  <th class="text-end">Monthly Fare</th>
                </tr>
              </thead>
              <tbody>
                <tr t-foreach="transport" t-as="reg">
                  <td>
                    <strong><t t-out="reg.route_id.code or '—'"/></strong>
                    <span class="ms-1" style="color:var(--sds-muted);">
                      – <t t-out="reg.route_id.name or ''"/>
                    </span>
                  </td>
                  <td>
                    <t t-out="reg.route_id.vehicle_id.name or '—'"/>
                    <t t-if="reg.route_id.vehicle_id.model_name">
                      <small class="text-muted ms-1">(<t t-out="reg.route_id.vehicle_id.model_name"/>)</small>
                    </t>
                  </td>
                  <td>
                    <t t-out="reg.route_id.vehicle_id.driver_name or '—'"/>
                    <t t-if="reg.route_id.vehicle_id.driver_phone">
                      <br/>
                      <small class="text-muted"><i class="fa fa-phone me-1"/><t t-out="reg.route_id.vehicle_id.driver_phone"/></small>
                    </t>
                  </td>
                  <td><t t-out="reg.pickup_point or '—'"/></td>
                  <td class="text-end" style="font-weight:700;color:var(--sds-teal-dk);">
                    <t t-out="'%.2f' % (reg.monthly_fare or 0)"/>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
        </t>
        <t t-else="">
          <div class="sds_empty" style="padding:22px;">
            <i class="fa fa-bus"/>
            No active transport subscription found for this student.
          </div>
        </t>
      </div>

      <!-- ── ATTENDANCE ──────────────────────────────────────────────────── -->
      <div class="sds_card mb-4">
        <div class="sds_card_head">
          <div>
            <span class="sds_eyebrow"><i class="fa fa-calendar-check-o"/> Records</span>
            <h2>Attendance</h2>
          </div>
          <t t-if="att_total">
            <span style="font-size:13px;font-weight:700;color:var(--sds-teal-dk);">
              <t t-out="att_pct"/>% present
            </span>
          </t>
        </div>

        <!-- Attendance summary bar -->
        <t t-if="att_total">
          <div class="sds_att_bar_wrap mb-3">
            <div class="d-flex justify-content-between" style="font-size:12px;margin-bottom:6px;">
              <span style="color:var(--sds-teal-dk);font-weight:700;">
                <i class="fa fa-check-circle me-1"/><t t-out="att_present"/> Present
              </span>
              <span style="color:var(--sds-rose-dk);font-weight:700;">
                <i class="fa fa-times-circle me-1"/><t t-out="att_absent"/> Absent
              </span>
              <span style="color:var(--sds-muted);font-weight:600;">
                <t t-out="att_total"/> Total
              </span>
            </div>
            <div class="sds_att_track">
              <div class="sds_att_fill" t-att-style="'width:%s%%' % att_pct"/>
            </div>
            <div style="font-size:11px;color:var(--sds-muted);text-align:right;">
              <t t-out="att_pct"/>% attendance rate
            </div>
          </div>
        </t>

        <div class="table-responsive">
          <table class="sds_tbl">
            <thead>
              <tr><th>Date</th><th>Status</th><th>Reason</th></tr>
            </thead>
            <tbody>
              <tr t-foreach="attendance" t-as="line">
                <td style="font-size:13px;font-weight:600;">
                  <t t-out="line.attendance_id.date"/>
                </td>
                <td>
                  <span t-attf-class="sds_att_pill sds_att_#{(line.state or 'present').lower()}">
                    <i t-attf-class="fa fa-{'check' if (line.state or 'present') == 'present' else 'times'} me-1"/>
                    <t t-out="(line.state or 'Present').capitalize()"/>
                  </span>
                </td>
                <td style="color:var(--sds-muted);font-size:12px;">
                  <t t-out="line.absence_reason or '—'"/>
                </td>
              </tr>
              <tr t-if="not attendance">
                <td colspan="3">
                  <div class="sds_empty" style="padding:24px;">
                    <i class="fa fa-calendar-o"/>No attendance records found.
                  </div>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- ── REPORT CARD / EXAM RESULTS ─────────────────────────────────── -->
      <div class="sds_card mb-4">
        <div class="sds_card_head">
          <div>
            <span class="sds_eyebrow"><i class="fa fa-bar-chart"/> Academics</span>
            <h2>Report Card &amp; Exam Results</h2>
          </div>
        </div>
        <div class="table-responsive">
          <table class="sds_tbl">
            <thead>
              <tr>
                <th>Exam</th>
                <th class="text-center">Percentage</th>
                <th class="text-center">Grade</th>
                <th class="text-center">Result</th>
                <th>Comments</th>
              </tr>
            </thead>
            <tbody>
              <tr t-foreach="results" t-as="result">
                <td style="font-weight:600;"><t t-out="result.exam_id.name"/></td>
                <td class="text-center">
                  <span style="font-weight:800;color:var(--sds-indigo);font-size:15px;">
                    <t t-out="result.percentage"/>%
                  </span>
                </td>
                <td class="text-center">
                  <span style="font-weight:700;background:var(--sds-indigo-lt);color:var(--sds-indigo);
                               padding:4px 12px;border-radius:100px;font-size:12px;">
                    <t t-out="result.final_grade"/>
                  </span>
                </td>
                <td class="text-center">
                  <span t-attf-class="sds_badge #{'sds_badge_approved' if result.overall_result == 'pass' else 'sds_badge_rejected'}">
                    <t t-out="(result.overall_result or '').capitalize()"/>
                  </span>
                </td>
                <td style="color:var(--sds-muted);font-size:12px;">
                  <t t-out="result.teacher_comments or '—'"/>
                </td>
              </tr>
              <tr t-if="not results">
                <td colspan="5">
                  <div class="sds_empty" style="padding:24px;">
                    <i class="fa fa-bar-chart"/>No exam results are available yet.
                  </div>
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Per-exam subject breakdown -->
        <t t-foreach="results" t-as="result">
          <t t-if="result.line_ids">
            <div class="sds_card mt-3" style="border:1px solid var(--sds-indigo-lt);box-shadow:none;">
              <div class="sds_card_head" style="margin-bottom:12px;">
                <div>
                  <span class="sds_eyebrow"><i class="fa fa-list-ul"/> Subject Breakdown</span>
                  <h2 style="font-size:14px;"><t t-out="result.exam_id.name"/></h2>
                </div>
              </div>
              <div class="table-responsive">
                <table class="sds_tbl">
                  <thead>
                    <tr>
                      <th>Subject</th>
                      <th class="text-center">Max</th>
                      <th class="text-center">Pass</th>
                      <th class="text-center">Obtained</th>
                      <th class="text-center">Status</th>
                    </tr>
                  </thead>
                  <tbody>
                    <tr t-foreach="result.line_ids" t-as="line">
                      <td style="font-weight:600;"><t t-out="line.subject_id.name"/></td>
                      <td class="text-center"><t t-out="line.max_marks"/></td>
                      <td class="text-center"><t t-out="line.pass_marks"/></td>
                      <td class="text-center" style="font-weight:800;color:var(--sds-indigo);"><t t-out="line.obtained_marks"/></td>
                      <td class="text-center">
                        <span t-attf-class="sds_badge #{'sds_badge_approved' if line.result == 'pass' else 'sds_badge_rejected'}">
                          <t t-out="(line.result or '').capitalize()"/>
                        </span>
                      </td>
                    </tr>
                  </tbody>
                </table>
              </div>
            </div>
          </t>
        </t>

      </div>
    </div>
  </t>
</template>

<!-- ═══════════════════════════════════════════════════════════════════════════
     7. FEE DETAIL PAGE
     ═══════════════════════════════════════════════════════════════════════════ -->
<template id="portal_fee_detail" name="Fee Statement">
  <t t-call="portal.portal_layout">
    <div class="sds_portal_wrap container py-4">

      <a href="/my/school/fees" class="sds_back">
        <i class="fa fa-arrow-left"/> Back to My School Fees
      </a>

      <!-- Invoice header -->
      <div class="sds_card mb-4">
        <div class="d-flex align-items-flex-start justify-content-between flex-wrap gap-3">
          <div>
            <span class="sds_eyebrow"><i class="fa fa-file-text-o"/> Invoice</span>
            <h1 style="font-size:22px;font-weight:800;margin:4px 0;"><t t-out="fee.name"/></h1>
            <p style="color:var(--sds-muted);font-size:13px;margin:0;">
              Fee statement for <strong><t t-out="fee.student_id.name"/></strong>
            </p>
          </div>
          <span t-attf-class="sds_badge sds_badge_{fee.state}" style="font-size:13px;padding:7px 14px;">
            <t t-out="fee_state_labels.get(fee.state, fee.state)"/>
          </span>
        </div>
        <div class="sds_info_grid mt-4">
          <div class="sds_info_item">
            <span class="label"><i class="fa fa-calendar me-1"/>Invoice Date</span>
            <span class="value"><t t-out="fee.date_invoice or '—'"/></span>
          </div>
          <div class="sds_info_item">
            <span class="label"><i class="fa fa-clock-o me-1"/>Due Date</span>
            <span class="value"><t t-out="fee.date_due or '—'"/></span>
          </div>
          <div class="sds_info_item" style="border-color:var(--sds-rose);background:var(--sds-rose-lt);">
            <span class="label" style="color:var(--sds-rose-dk);"><i class="fa fa-exclamation-circle me-1"/>Balance Due</span>
            <span class="value" style="color:var(--sds-rose-dk);font-size:18px;">
              <t t-out="'%.2f' % fee.amount_due"/>
            </span>
          </div>
        </div>
      </div>

      <!-- Line items -->
      <div class="sds_card">
        <div class="sds_card_head">
          <div>
            <span class="sds_eyebrow"><i class="fa fa-list-ul"/> Breakdown</span>
            <h2>Fee Components</h2>
          </div>
        </div>
        <div class="table-responsive">
          <table class="sds_tbl">
            <thead>
              <tr>
                <th>Fee Head</th>
                <th>Remarks</th>
                <th class="text-end">Amount</th>
              </tr>
            </thead>
            <tbody>
              <tr t-foreach="fee.line_ids" t-as="line">
                <td style="font-weight:600;"><t t-out="line.fee_head_id.name"/></td>
                <td style="color:var(--sds-muted);font-size:12px;"><t t-out="line.remarks or '—'"/></td>
                <td class="text-end" style="font-weight:700;"><t t-out="'%.2f' % line.amount"/></td>
              </tr>
            </tbody>
            <tfoot>
              <tr>
                <td colspan="2" style="font-size:13px;">
                  <i class="fa fa-calculator me-1"/>Total
                </td>
                <td class="text-end" style="font-size:16px;color:var(--sds-ink);">
                  <t t-out="'%.2f' % fee.amount_total"/>
                </td>
              </tr>
              <tr>
                <td colspan="2" style="font-size:13px;color:var(--sds-teal-dk);">
                  <i class="fa fa-check-circle me-1"/>Amount Paid
                </td>
                <td class="text-end" style="font-size:15px;color:var(--sds-teal-dk);">
                  <t t-out="'%.2f' % fee.amount_paid"/>
                </td>
              </tr>
              <tr>
                <td colspan="2" style="font-size:13px;color:var(--sds-rose-dk);">
                  <i class="fa fa-exclamation-circle me-1"/>Balance Due
                </td>
                <td class="text-end" style="font-size:15px;color:var(--sds-rose-dk);">
                  <t t-out="'%.2f' % fee.amount_due"/>
                </td>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>

    </div>
  </t>
</template>

</odoo>
