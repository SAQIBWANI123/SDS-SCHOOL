<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_school_teacher_tree" model="ir.ui.view">
        <field name="name">school.teacher.list</field>
        <field name="model">school.teacher</field>
        <field name="arch" type="xml">
            <list string="Teachers &amp; Staff">
                <field name="teacher_id_code"/>
                <field name="name"/>
                <field name="qualification"/>
                <field name="specialization"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="date_of_joining"/>
            </list>
        </field>
    </record>

    <record id="view_school_teacher_form" model="ir.ui.view">
        <field name="name">school.teacher.form</field>
        <field name="model">school.teacher</field>
        <field name="arch" type="xml">
            <form string="Teacher Profile">
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'zoom': true}"/>
                    <div class="oe_title">
                        <label for="name" string="Teacher Name"/>
                        <h1>
                            <field name="name" placeholder="Full Name" required="1"/>
                        </h1>
                        <h3>
                            <field name="teacher_id_code" readonly="1"/>
                        </h3>
                    </div>
                    <group>
                        <group string="Professional Info">
                            <field name="qualification"/>
                            <field name="specialization"/>
                            <field name="date_of_joining"/>
                            <field name="gender"/>
                        </group>
                        <group string="Contact Info">
                            <field name="email"/>
                            <field name="phone"/>
                            <field name="mobile"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Teaches Subjects">
                            <field name="subject_ids">
                                <list>
                                    <field name="code"/>
                                    <field name="name"/>
                                    <field name="subject_type"/>
                                </list>
                            </field>
                        </page>
                        <page string="Class Teacher Responsibilities">
                            <field name="class_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="grade_id"/>
                                    <field name="section"/>
                                    <field name="student_count"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_school_teacher" model="ir.actions.act_window">
        <field name="name">Teachers &amp; Faculty</field>
        <field name="res_model">school.teacher</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_school_teacher"
              name="Teachers &amp; Faculty"
              parent="menu_school_students_root"
              action="action_school_teacher"
              sequence="2"/>
</odoo>
