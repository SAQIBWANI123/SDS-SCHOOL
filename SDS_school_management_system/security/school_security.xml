<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- User Groups -->
        <record id="group_school_student" model="res.groups">
            <field name="name">School / Student</field>
        </record>

        <record id="group_school_parent" model="res.groups">
            <field name="name">School / Parent or Guardian</field>
        </record>

        <record id="group_school_teacher" model="res.groups">
            <field name="name">School / Teacher or Faculty</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_school_manager" model="res.groups">
            <field name="name">School / Administrator</field>
            <field name="implied_ids" eval="[(4, ref('group_school_teacher'))]"/>
            <!-- The default administrator can use the app right after installation -->
            <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
