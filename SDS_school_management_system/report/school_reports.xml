<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Student ID Card Report Action -->
    <record id="action_report_student_id_card" model="ir.actions.report">
        <field name="name">Student ID Card</field>
        <field name="model">school.student</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">SDS_school_management_system.report_student_id_card</field>
        <field name="report_file">SDS_school_management_system.report_student_id_card</field>
        <field name="print_report_name">'Student_ID_Card_%s' % (object.student_id_code)</field>
        <field name="binding_model_id" ref="model_school_student"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Student Academic Report Card Action -->
    <record id="action_report_student_report_card" model="ir.actions.report">
        <field name="name">Academic Report Card</field>
        <field name="model">school.exam.result</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">SDS_school_management_system.report_student_report_card</field>
        <field name="report_file">SDS_school_management_system.report_student_report_card</field>
        <field name="print_report_name">'Report_Card_%s' % (object.student_id.name)</field>
        <field name="binding_model_id" ref="model_school_exam_result"/>
        <field name="binding_type">report</field>
    </record>

    <!-- Fee Receipt Report Action -->
    <record id="action_report_fee_receipt" model="ir.actions.report">
        <field name="name">Fee Payment Receipt</field>
        <field name="model">school.student.fee</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">SDS_school_management_system.report_fee_receipt</field>
        <field name="report_file">SDS_school_management_system.report_fee_receipt</field>
        <field name="print_report_name">'Fee_Receipt_%s' % (object.name)</field>
        <field name="binding_model_id" ref="model_school_student_fee"/>
        <field name="binding_type">report</field>
    </record>
</odoo>
