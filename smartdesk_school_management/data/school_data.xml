<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="param_library_fine_per_day" model="ir.config_parameter">
            <field name="key">school.library_fine_per_day</field>
            <field name="value">1.0</field>
        </record>
    </data>

    <record id="ir_cron_library_overdue" model="ir.cron">
        <field name="name">School: flag overdue library loans</field>
        <field name="model_id" ref="model_school_library_issue"/>
        <field name="state">code</field>
        <field name="code">model._cron_flag_overdue()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
