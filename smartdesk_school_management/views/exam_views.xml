<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Grade Scale Views -->
    <record id="view_school_grade_scale_tree" model="ir.ui.view">
        <field name="name">school.grade.scale.list</field>
        <field name="model">school.grade.scale</field>
        <field name="arch" type="xml">
            <list editable="bottom" string="Grade Scales">
                <field name="name"/>
                <field name="min_per"/>
                <field name="max_per"/>
                <field name="gpa"/>
                <field name="remarks"/>
            </list>
        </field>
    </record>

    <record id="action_school_grade_scale" model="ir.actions.act_window">
        <field name="name">Grading Scales</field>
        <field name="res_model">school.grade.scale</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Exam Views -->
    <record id="view_school_exam_tree" model="ir.ui.view">
        <field name="name">school.exam.list</field>
        <field name="model">school.exam</field>
        <field name="arch" type="xml">
            <list string="Examinations">
                <field name="code"/>
                <field name="name"/>
                <field name="academic_year_id"/>
                <field name="grade_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'ongoing'"
                       decoration-success="state == 'completed'"/>
            </list>
        </field>
    </record>

    <record id="view_school_exam_form" model="ir.ui.view">
        <field name="name">school.exam.form</field>
        <field name="model">school.exam</field>
        <field name="arch" type="xml">
            <form string="Examination">
                <header>
                    <button name="action_start" string="Start Exam" type="object" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_generate_report_cards" string="Generate Report Cards" type="object" invisible="state == 'completed'"/>
                    <button name="action_complete" string="Mark Completed" type="object" class="btn-success" invisible="state != 'ongoing'"/>
                    <button name="action_reset_draft" string="Reset to Draft" type="object" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,ongoing,completed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_results" type="object" class="oe_stat_button" icon="fa-file-text-o">
                            <field name="result_count" widget="statinfo" string="Report Cards"/>
                        </button>
                        <button name="action_view_results" type="object" class="oe_stat_button" icon="fa-check-circle" invisible="result_count == 0">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="pass_rate"/>%</span>
                                <span class="o_stat_text">Pass Rate</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Annual Final Exam 2026"/>
                        </h1>
                        <h3>
                            <field name="code" readonly="1"/>
                        </h3>
                    </div>
                    <group>
                        <group>
                            <field name="academic_year_id"/>
                            <field name="term_id"/>
                            <field name="grade_id"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                    </group>
                    <field name="description" placeholder="Exam timetable details or guidelines..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_school_exam" model="ir.actions.act_window">
        <field name="name">Examinations</field>
        <field name="res_model">school.exam</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Exam Result (Report Card) Views -->
    <record id="view_school_exam_result_tree" model="ir.ui.view">
        <field name="name">school.exam.result.list</field>
        <field name="model">school.exam.result</field>
        <field name="arch" type="xml">
            <list string="Student Report Cards">
                <field name="name"/>
                <field name="student_id"/>
                <field name="class_id"/>
                <field name="exam_id"/>
                <field name="total_obtained_marks"/>
                <field name="total_max_marks"/>
                <field name="percentage"/>
                <field name="final_grade"/>
                <field name="overall_result" widget="badge"
                       decoration-success="overall_result == 'pass'"
                       decoration-danger="overall_result == 'fail'"/>
            </list>
        </field>
    </record>

    <record id="view_school_exam_result_form" model="ir.ui.view">
        <field name="name">school.exam.result.form</field>
        <field name="model">school.exam.result</field>
        <field name="arch" type="xml">
            <form string="Student Report Card">
                <header>
                    <button name="action_generate_lines" string="Auto-Fetch Subjects" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Exam &amp; Student">
                            <field name="exam_id"/>
                            <field name="student_id"/>
                            <field name="class_id"/>
                        </group>
                        <group string="Performance Summary">
                            <field name="total_obtained_marks"/>
                            <field name="total_max_marks"/>
                            <field name="percentage"/>
                            <field name="final_grade"/>
                            <field name="rank"/>
                            <field name="overall_result" widget="badge"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Subject Marks &amp; Grades">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="subject_id"/>
                                    <field name="max_marks"/>
                                    <field name="pass_marks"/>
                                    <field name="obtained_marks"/>
                                    <field name="result" widget="badge"
                                           decoration-success="result == 'pass'"
                                           decoration-danger="result == 'fail'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Teacher Remarks">
                            <field name="teacher_comments" placeholder="Class teacher evaluation and feedback..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_school_exam_result" model="ir.actions.act_window">
        <field name="name">Report Cards &amp; Results</field>
        <field name="res_model">school.exam.result</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menus -->
    <menuitem id="menu_school_exam"
              name="Exams Schedule"
              parent="menu_school_operations_root"
              action="action_school_exam"
              sequence="2"/>

    <menuitem id="menu_school_exam_result"
              name="Student Report Cards"
              parent="menu_school_operations_root"
              action="action_school_exam_result"
              sequence="3"/>

    <menuitem id="menu_school_grade_scale"
              name="Grading Scales"
              parent="menu_school_config_root"
              action="action_school_grade_scale"
              sequence="3"/>
</odoo>
