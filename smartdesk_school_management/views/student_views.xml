<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- STUDENT LIST VIEW -->

    <record id="view_school_student_tree" model="ir.ui.view">
        <field name="name">school.student.list</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <list>
                <field name="student_id_code"/>
                <field name="name"/>
                <field name="roll_number"/>
                <field name="grade_id"/>
                <field name="class_id"/>
                <field name="gender"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="state"
                       widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'enrolled'"
                       decoration-warning="state == 'suspended'"
                       decoration-danger="state == 'graduated'"/>
            </list>
        </field>
    </record>


    <!-- STUDENT KANBAN VIEW -->

    <record id="view_school_student_kanban" model="ir.ui.view">
        <field name="name">school.student.kanban</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">

            <kanban default_group_by="grade_id">

                <field name="id"/>
                <field name="name"/>
                <field name="student_id_code"/>
                <field name="image_1920"/>
                <field name="class_id"/>
                <field name="state"/>

                <templates>
                    <t t-name="card">
                        <div class="d-flex align-items-center">
                            <div class="me-3">
                                <field name="image_1920"
                                       widget="image"
                                       class="o_kanban_image rounded-circle"
                                       style="width:50px; height:50px; object-fit:cover;"/>
                            </div>
                            <div>
                                <strong class="o_kanban_record_title">
                                    <field name="name"/>
                                </strong>
                                <div>
                                    <small class="text-muted">
                                        <field name="student_id_code"/> | Class: <field name="class_id"/>
                                    </small>
                                </div>
                                <div class="mt-1">
                                    <field name="state" widget="badge"
                                           decoration-info="state == 'draft'"
                                           decoration-success="state == 'enrolled'"
                                           decoration-warning="state == 'suspended'"
                                           decoration-danger="state == 'graduated'"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>

            </kanban>

        </field>
    </record>


    <!-- STUDENT FORM VIEW -->

    <record id="view_school_student_form" model="ir.ui.view">
        <field name="name">school.student.form</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">

            <form>

                <!-- HEADER -->

                <header>

                    <button name="action_enroll"
                            string="Enroll Student"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <button name="action_promote"
                            string="Promote / Move"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'enrolled'"/>

                    <button name="action_graduate"
                            string="Graduate"
                            type="object"
                            invisible="state != 'enrolled'"/>

                    <button name="action_suspend"
                            string="Suspend"
                            type="object"
                            class="btn-danger"
                            invisible="state in ['graduated', 'suspended']"/>

                    <button name="action_reinstate"
                            string="Reinstate"
                            type="object"
                            invisible="state != 'suspended'"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,enrolled,graduated"/>

                </header>


                <!-- SHEET -->

                <sheet>

                    <!-- SMART BUTTONS -->

                    <div class="oe_button_box" name="button_box">

                        <button class="oe_stat_button"
                                icon="fa-percent"
                                type="object"
                                name="action_view_attendance">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="attendance_percentage"/>%
                                </span>
                                <span class="o_stat_text">Attendance</span>
                            </div>
                        </button>

                        <button class="oe_stat_button"
                                icon="fa-money"
                                type="object"
                                name="action_view_fees">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="total_fee_due"/>
                                </span>
                                <span class="o_stat_text">Fee Due</span>
                            </div>
                        </button>

                        <button class="oe_stat_button"
                                icon="fa-book"
                                type="object"
                                name="action_view_books">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="books_borrowed_count"/>
                                </span>
                                <span class="o_stat_text">Books Issued</span>
                            </div>
                        </button>

                        <button class="oe_stat_button"
                                icon="fa-graduation-cap"
                                type="object"
                                name="action_view_exam_results">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="exam_results_count"/>
                                </span>
                                <span class="o_stat_text">Exam Results</span>
                            </div>
                        </button>

                        <button class="oe_stat_button"
                                icon="fa-star"
                                type="action"
                                name="%(action_school_student_conduct)d"
                                context="{'search_default_student_id': id}">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value">
                                    <field name="conduct_score"/>
                                </span>
                                <span class="o_stat_text">Conduct Score</span>
                            </div>
                        </button>

                    </div>


                    <!-- STUDENT PHOTO -->

                    <field name="image_1920"
                           widget="image"
                           class="oe_avatar"
                           options="{'zoom': true}"/>


                    <!-- TITLE -->

                    <div class="oe_title">

                        <label for="name" string="Student Name"/>

                        <h1>
                            <field name="name"
                                   placeholder="Full Student Name"
                                   required="1"/>
                        </h1>

                        <h3>
                            <field name="student_id_code" readonly="1"/>
                        </h3>

                    </div>


                    <!-- BASIC INFORMATION -->

                    <group>

                        <group string="Academic Information">
                            <field name="grade_id"/>
                            <field name="class_id"/>
                            <field name="roll_number"/>
                            <field name="academic_year_id"/>
                            <field name="admission_date"/>
                        </group>

                        <group string="Personal Information">
                            <field name="date_of_birth"/>
                            <field name="gender"/>
                            <field name="blood_group"/>
                            <field name="email"/>
                            <field name="phone"/>
                        </group>

                    </group>


                    <!-- NOTEBOOK -->

                    <notebook>

                        <!-- PARENT & GUARDIANS -->

                        <page string="Parent &amp; Guardians">
                            <group>
                                <field name="primary_parent_id"/>
                            </group>
                            <field name="parent_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="relation_type"/>
                                    <field name="phone"/>
                                    <field name="email"/>
                                    <field name="occupation"/>
                                </list>
                            </field>
                        </page>


                        <!-- CONTACT & ADDRESS -->

                        <page string="Contact &amp; Address">
                            <group>
                                <label for="street" string="Address"/>
                                <div class="o_address_format">
                                    <field name="street"
                                           placeholder="Street..."
                                           class="o_address_street"/>
                                    <field name="street2"
                                           placeholder="Street 2..."
                                           class="o_address_street"/>
                                    <field name="city"
                                           placeholder="City"
                                           class="o_address_city"/>
                                    <field name="state_id"
                                           class="o_address_state"
                                           placeholder="State"
                                           options="{'no_open': True}"/>
                                    <field name="zip"
                                           placeholder="ZIP"
                                           class="o_address_zip"/>
                                    <field name="country_id"
                                           placeholder="Country"
                                           class="o_address_country"
                                           options="{'no_open': True}"/>
                                </div>
                            </group>
                        </page>


                        <!-- CONDUCT -->

                        <page string="Conduct &amp; Achievements">
                            <field name="conduct_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="type"/>
                                    <field name="name"/>
                                    <field name="points"/>
                                    <field name="description" optional="hide"/>
                                </list>
                            </field>
                        </page>


                        <!-- MEDICAL NOTES -->

                        <page string="Medical &amp; Notes">
                            <field name="medical_notes"
                                   placeholder="Enter medical history, food allergies, or special requirements..."/>
                        </page>

                    </notebook>

                </sheet>


                <!-- CHATTER -->

                <chatter/>

            </form>

        </field>
    </record>


    <!-- STUDENT SEARCH VIEW -->

    <record id="view_school_student_search" model="ir.ui.view">
        <field name="name">school.student.search</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="student_id_code"/>
                <field name="roll_number"/>
                <field name="grade_id"/>
                <field name="class_id"/>

                <filter name="enrolled"
                        string="Enrolled"
                        domain="[('state', '=', 'enrolled')]"/>
                <filter name="draft"
                        string="Draft"
                        domain="[('state', '=', 'draft')]"/>
                <filter name="suspended"
                        string="Suspended"
                        domain="[('state', '=', 'suspended')]"/>
                <filter name="graduated"
                        string="Graduated"
                        domain="[('state', '=', 'graduated')]"/>

                <group>
                    <filter name="group_grade"
                            string="Grade Level"
                            context="{'group_by': 'grade_id'}"/>
                    <filter name="group_class"
                            string="Class / Section"
                            context="{'group_by': 'class_id'}"/>
                    <filter name="group_state"
                            string="Status"
                            context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>


    <!-- STUDENT ACTION -->

    <record id="action_school_student" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">school.student</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_school_student_search"/>
        <field name="context">{'search_default_enrolled': 1}</field>
    </record>


    <!-- STUDENT MENU -->

    <menuitem id="menu_school_student"
              name="Student Directory"
              parent="menu_school_students_root"
              action="action_school_student"
              sequence="1"/>


    <!-- PROMOTION WIZARD -->

    <record id="view_school_promote_wizard_form" model="ir.ui.view">
        <field name="name">school.promote.wizard.form</field>
        <field name="model">school.promote.wizard</field>
        <field name="arch" type="xml">
            <form string="Promote Students">
                <group>
                    <group>
                        <field name="mode" widget="radio"/>
                        <field name="from_class_id" options="{'no_create': True}"/>
                    </group>
                    <group invisible="mode != 'promote'">
                        <field name="target_grade_id" required="mode == 'promote'" options="{'no_create': True}"/>
                        <field name="target_class_id" options="{'no_create': True}"/>
                        <field name="target_year_id" options="{'no_create': True}"/>
                    </group>
                </group>
                <field name="student_ids" nolabel="1">
                    <list>
                        <field name="student_id_code"/>
                        <field name="name"/>
                        <field name="grade_id"/>
                        <field name="class_id"/>
                    </list>
                </field>
                <footer>
                    <button name="action_apply" string="Apply" type="object" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-secondary" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_school_promote_wizard" model="ir.actions.act_window">
        <field name="name">Promote Students</field>
        <field name="res_model">school.promote.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_school_student"/>
        <field name="binding_view_types">list</field>
    </record>

    <menuitem id="menu_school_promote"
              name="Promote Students"
              parent="menu_school_academics_root"
              action="action_school_promote_wizard"
              sequence="20"
              groups="smartdesk_school_management.group_school_manager"/>

</odoo>
