<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Academic Year Tree View -->
    <record id="view_academic_year_tree" model="ir.ui.view">
        <field name="name">school.academic.year.list</field>
        <field name="model">school.academic.year</field>
        <field name="arch" type="xml">
            <list string="Academic Years">
                <field name="name"/>
                <field name="code"/>
                <field name="date_start"/>
                <field name="date_end"/>
                <field name="current"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Academic Year Form View -->
    <record id="view_academic_year_form" model="ir.ui.view">
        <field name="name">school.academic.year.form</field>
        <field name="model">school.academic.year</field>
        <field name="arch" type="xml">
            <form string="Academic Year">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. 2026-2027"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="current"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="date_start"/>
                            <field name="date_end"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Academic Terms">
                            <field name="term_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="date_start"/>
                                    <field name="date_end"/>
                                    <field name="active"/>
                                </list>
                            </field>
                        </page>
                        <page string="Notes">
                            <field name="description"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_academic_year" model="ir.actions.act_window">
        <field name="name">Academic Years</field>
        <field name="res_model">school.academic.year</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menuitem -->
    <menuitem id="menu_academic_year"
              name="Academic Years &amp; Terms"
              parent="menu_school_config_root"
              action="action_academic_year"
              sequence="1"/>
</odoo>
